# --- BUILD STAGE ---
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install all build dependencies including Qt5 for IDE
# Using retry logic to handle transient network issues
RUN apt-get update && \
    for i in 1 2 3 4 5; do \
    apt-get install -y --fix-missing \
    build-essential cmake git \
    libjack-jackd2-dev libsndfile1-dev libasound2-dev \
    libavahi-client-dev libicu-dev libreadline-dev \
    libfftw3-dev libxt-dev libudev-dev \
    qtbase5-dev qt5-qmake qttools5-dev qttools5-dev-tools \
    libqt5svg5-dev libqt5websockets5-dev \
    qtwebengine5-dev \
    libyaml-cpp-dev \
    && break || sleep 10; \
    done && rm -rf /var/lib/apt/lists/*

# Copy local source code (with auto-reload modification)
COPY . /tmp/sc

WORKDIR /tmp/sc
RUN mkdir -p build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
    -DNATIVE=ON \
    -DSC_EL=OFF \
    -DSC_IDE=ON \
    -DSC_QT=ON \
    -DNO_X11=OFF \
    .. && \
    make -j$(nproc) && \
    make install

# --- RUNTIME STAGE ---
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime libs + X11 for GUI + jackd for audio + python3
# Using retry logic to handle transient network issues
RUN apt-get update && \
    for i in 1 2 3 4 5; do \
    apt-get install -y --fix-missing \
    libjack-jackd2-0 libsndfile1 libasound2 \
    libavahi-client3 libicu70 libreadline8 \
    libfftw3-3 libqt5core5a libqt5gui5 libqt5network5 libqt5widgets5 \
    libqt5svg5 libqt5websockets5 libqt5webenginewidgets5 \
    libqt5printsupport5 libqt5concurrent5 libqt5opengl5 \
    libyaml-cpp0.7 \
    jackd2 python3 git \
    libx11-6 libxcb1 libxext6 libxrender1 libxi6 \
    libxkbcommon-x11-0 libxcb-icccm4 libxcb-image0 \
    libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
    libxcb-shape0 libxcb-xfixes0 libxcb-xinerama0 \
    libxcb-cursor0 libxcb-util1 \
    dbus-x11 libgl1-mesa-glx libgl1-mesa-dri \
    x11-utils \
    && break || sleep 5; \
    done && rm -rf /var/lib/apt/lists/*

# Setup directory structure
WORKDIR /app
RUN mkdir -p /root/.local/share/SuperCollider/Extensions \
    && mkdir -p /root/.local/share/SuperCollider/downloaded-quarks \
    && mkdir -p /root/.config/SuperCollider

# Copy binaries from builder
COPY --from=builder /usr/local /usr/local

# Add the entrypoint script
COPY docker/entrypoint-gui.sh /app/entrypoint-gui.sh
RUN chmod +x /app/entrypoint-gui.sh

# Environment for X11 and Qt
ENV QT_X11_NO_MITSHM=1
ENV LIBGL_ALWAYS_INDIRECT=1

ENTRYPOINT ["/app/entrypoint-gui.sh"]
CMD ["scide"]
